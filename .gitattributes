# ===== .gitattributes =====
* text=auto

# Windows-friendly (CRLF) pour fichiers solution/projet/code
*.sln      text eol=crlf
*.cs       text eol=crlf
*.razor    text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf

# LF pour scripts/config cross-plateforme
*.sh       text eol=lf
*.bash     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore     text eol=lf
