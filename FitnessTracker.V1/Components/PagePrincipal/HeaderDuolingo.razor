@using FitnessTracker.V1.Models.Gamification
@using FitnessTracker.V1.Services.Data
@using FitnessTracker.V1.Services.Gamification
@inject AuthService AuthService
@inject GamificationDbService GamificationDbService
@inject SupabaseService2 SupabaseService
@inject FitnessTracker.V1.Models.AppState appState

<div class="duo-header full-width">
    @if (AuthService.IsAuthenticated)
    {
        <div class="profile-section">
            <div class="profile-avatar" title="Profil">👤</div>
        </div>

        @if (Gamification != null)
        {
            var level = GamificationRules.GetLevel(Gamification.TotalXP);
            var progress = GamificationRules.GetLevelProgressPercent(Gamification.TotalXP);
            var streak = GetActiveStreak(Gamification);

            <div class="xp-summary">
                <div class="xp-summary-top">
                    <span>Niv. @level</span>
                    <span>@Gamification.TotalXP XP</span>
                </div>
                <div class="xp-meter" title="@GamificationRules.GetMotivation(Gamification)">
                    <div class="xp-meter-fill" style="width:@progress.ToString("0")%"></div>
                </div>
                <div class="xp-summary-bottom">@GamificationRules.GetLevelTitle(level)</div>
            </div>

            <div class="streak-badge" title="Série active">
                🔥 @streak jour@(streak > 1 ? "s" : "")
            </div>
        }

        <a class="btn btn-light btn-sm" href="/logout" title="Se déconnecter">
            <i class="bi bi-box-arrow-right"></i>
        </a>
    }
    else
    {
        <a class="btn btn-light btn-sm" href="/login" title="Se connecter">
            <i class="bi bi-box-arrow-in-right"></i>
        </a>
    }
</div>

@code {
    [Parameter] public bool ShowGamification { get; set; } = true;
    private GamificationDbModel? Gamification;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            var restored = await SupabaseService.LoadSessionAsync();
            Console.WriteLine($"Session restaurée dans Header : {restored}");
        }

        if (AuthService.IsAuthenticated && ShowGamification)
        {
            Gamification = appState.Gamification;

            if (Gamification == null)
            {
                Gamification = await GamificationDbService.GetOrCreateGamificationAsync();
                appState.Gamification = Gamification;
                Console.WriteLine("Gamification chargee et stockee dans AppState.");
            }
        }
    }

    private static int GetActiveStreak(GamificationDbModel gamification)
    {
        if (gamification.LastSessionDate is null)
            return 0;

        var daysSinceLastSession = (DateTime.UtcNow.Date - gamification.LastSessionDate.Value.Date).Days;
        return daysSinceLastSession <= 1 ? gamification.StreakDays : 0;
    }
}
